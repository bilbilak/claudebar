#. key: brand_name, window_preferences_title, tooltip_default, installer_app_step
#. DO NOT TRANSLATE. Keep as 'ClaudeBar' in every language.
msgid "ClaudeBar"
msgstr "ClaudeBar"

#. key: menu_refresh_now
msgid "Refresh now"
msgstr "Jetzt aktualisieren"

#. key: menu_open_usage_page
msgid "Open claude.ai/settings/usage"
msgstr "claude.ai/settings/usage öffnen"

#. key: menu_settings
msgid "Settings…"
msgstr "Einstellungen…"

#. key: menu_quit
msgid "Quit ClaudeBar"
msgstr "ClaudeBar beenden"

#. key: menu_refresh, prefs_refresh_section
msgid "Refresh"
msgstr "Aktualisieren"

#. key: stat_session
msgid "Current session"
msgstr "Aktuelle Sitzung"

#. key: stat_session_dash
msgid "Current session: —"
msgstr "Aktuelle Sitzung: —"

#. key: stat_session_with_pct
msgid "Current session: %1%%"
msgstr "Aktuelle Sitzung: %1%%"

#. key: stat_weekly
msgid "Weekly (all models)"
msgstr "Wöchentlich (alle Modelle)"

#. key: stat_weekly_dash
msgid "Weekly (all models): —"
msgstr "Wöchentlich (alle Modelle): —"

#. key: stat_weekly_with_pct
msgid "Weekly (all models): %1%%"
msgstr "Wöchentlich (alle Modelle): %1%%"

#. key: stat_resets
#. %s is a time-relative string like 'in 5 min'.
msgid "Resets %1"
msgstr "Zurücksetzung %1"

#. key: time_now
msgid "now"
msgstr "jetzt"

#. key: time_dash
msgid "—"
msgstr "—"

#. key: time_in_minutes
msgid "in %1 min"
msgstr "in %1 Min."

#. key: time_in_hours
msgid "in %1h"
msgstr "in %1 Std."

#. key: time_in_hours_minutes
msgid "in %1h %2m"
msgstr "in %1 Std. %2 Min."

#. key: time_in_days
msgid "in %1d"
msgstr "in %1 T."

#. key: time_in_days_hours
msgid "in %1d %2h"
msgstr "in %1 T. %2 Std."

#. key: status_offline
msgid "Offline — last value may be stale"
msgstr "Offline — letzter Wert ist möglicherweise veraltet"

#. key: status_rate_limited
msgid "Rate limited by Claude API"
msgstr "Anfragelimit der Claude API erreicht"

#. key: status_unauthenticated
msgid "Not signed in — open Settings to add a token"
msgstr "Nicht angemeldet — Einstellungen öffnen, um ein Token hinzuzufügen"

#. key: auth_sign_in, signin_dialog_heading
msgid "Sign in with Claude"
msgstr "Mit Claude anmelden"

#. key: auth_sign_out
msgid "Sign out"
msgstr "Abmelden"

#. key: auth_signed_in_token
#. %s is the last 6 chars of the access token.
msgid "Signed in (token ends '…%1')"
msgstr "Angemeldet (Token endet auf '…%1')"

#. key: auth_not_signed_in
msgid "Not signed in"
msgstr "Nicht angemeldet"

#. key: auth_checking
msgid "Checking…"
msgstr "Wird geprüft…"

#. key: auth_waiting_browser
msgid "Waiting for browser sign-in…"
msgstr "Warten auf Anmeldung im Browser…"

#. key: auth_keyring_error
msgid "Keyring error — see logs"
msgstr "Schlüsselbund-Fehler — siehe Protokolle"

#. key: auth_sign_in_failed
msgid "Sign-in failed"
msgstr "Anmeldung fehlgeschlagen"

#. key: auth_could_not_start
msgid "Could not start sign-in"
msgstr "Anmeldung konnte nicht gestartet werden"

#. key: auth_copy_link
#. Short button label — used both in prefs dialogs and as a system-notification action where supported.
msgid "Copy link"
msgstr "Link kopieren"

#. key: auth_link_copied_notify
#. Notification body shown after a menu/popup Sign-in click. Body of an OS desktop notification (libnotify on Linux). Title is the brand name.
msgid "Sign-in link copied to clipboard"
msgstr "Anmeldelink in die Zwischenablage kopiert"

#. key: prefs_account
msgid "Account"
msgstr "Konto"

#. key: prefs_display
msgid "Display"
msgstr "Anzeige"

#. key: prefs_advanced
msgid "Advanced"
msgstr "Erweitert"

#. key: prefs_general
msgid "General"
msgstr "Allgemein"

#. key: prefs_authentication
msgid "Authentication"
msgstr "Authentifizierung"

#. key: prefs_status
msgid "Status"
msgstr "Status"

#. key: prefs_top_bar
msgid "Top bar"
msgstr "Obere Leiste"

#. key: prefs_tray_icon
msgid "Tray icon"
msgstr "Infobereich-Symbol"

#. key: prefs_color_thresholds
msgid "Color thresholds"
msgstr "Farb-Schwellenwerte"

#. key: prefs_labels
msgid "Labels:"
msgstr "Beschriftungen:"

#. key: prefs_account_subtitle
msgid "Sign in with your Claude account to fetch Max plan usage. Tokens are stored in GNOME Keyring via libsecret."
msgstr "Melden Sie sich mit Ihrem Claude-Konto an, um die Nutzung des Max-Tarifs abzurufen. Tokens werden über libsecret in GNOME Keyring gespeichert."

#. key: prefs_show_percentages
msgid "Show numeric percentages next to bars"
msgstr "Prozentwerte neben den Balken anzeigen"

#. key: prefs_show_percentages_subtitle
msgid "Small session and weekly percentages, stacked beside the bars."
msgstr "Kleine Sitzungs- und Wochenprozentwerte, neben den Balken übereinander angeordnet."

#. key: prefs_show_percentages_beside
msgid "Show numeric percentages beside the bars"
msgstr "Prozentwerte neben den Balken anzeigen"

#. key: prefs_color_thresholds_desc
msgid "When bars switch from green to orange to red."
msgstr "Wann die Balken von Grün auf Orange und dann auf Rot wechseln."

#. key: prefs_orange_at
msgid "Orange at"
msgstr "Orange bei"

#. key: prefs_red_at
msgid "Red at"
msgstr "Rot bei"

#. key: prefs_orange_at_pct
msgid "Orange at (%)"
msgstr "Orange bei (%)"

#. key: prefs_red_at_pct
msgid "Red at (%)"
msgstr "Rot bei (%)"

#. key: prefs_orange_at_short
msgid "Orange at (%):"
msgstr "Orange bei (%):"

#. key: prefs_red_at_short
msgid "Red at (%):"
msgstr "Rot bei (%):"

#. key: prefs_poll_interval_seconds
msgid "Poll interval (seconds)"
msgstr "Abfrageintervall (Sekunden)"

#. key: prefs_poll_interval_short
msgid "Poll interval (s):"
msgstr "Abfrageintervall (s):"

#. key: prefs_helper_path
msgid "Helper binary:"
msgstr "Hilfsprogramm-Binärdatei:"

#. key: meter_section
msgid "Floating desktop meter"
msgstr "Schwebende Desktop-Anzeige"

#. key: meter_enable
msgid "Show always-on-top meter on the desktop"
msgstr "Immer im Vordergrund liegende Anzeige auf dem Desktop einblenden"

#. key: meter_desc
msgid "Small transparent widget rendering full-size bars. Draggable into any corner; right-click to lock or hide."
msgstr "Kleines transparentes Widget mit Balken in voller Größe. In jede Ecke ziehbar; mit Rechtsklick fixieren oder ausblenden."

#. key: meter_show_percentages
msgid "Show numeric percentages on the floating meter"
msgstr "Prozentwerte auf der schwebenden Anzeige einblenden"

#. key: meter_show_percentages_subtitle
msgid "Adds session and weekly percentages next to the bars on the floating desktop meter (must be enabled below). The tray tooltip always shows percentages."
msgstr "Fügt die Sitzungs- und Wochenprozentwerte neben den Balken der schwebenden Desktop-Anzeige hinzu (muss unten aktiviert sein). Der Tooltip im Infobereich zeigt stets Prozentwerte an."

#. key: meter_opacity
msgid "Opacity:"
msgstr "Deckkraft:"

#. key: meter_width_px
msgid "Width (px):"
msgstr "Breite (px):"

#. key: meter_width_hint
msgid "(120–320)"
msgstr "(120–320)"

#. key: meter_lock
msgid "Lock position"
msgstr "Position fixieren"

#. key: meter_unlock
msgid "Unlock"
msgstr "Entsperren"

#. key: meter_hide
msgid "Hide meter"
msgstr "Anzeige ausblenden"

#. key: action_ok
msgid "OK"
msgstr "OK"

#. key: action_cancel
msgid "Cancel"
msgstr "Abbrechen"

#. key: action_close
msgid "Close"
msgstr "Schließen"

#. key: action_open
msgid "Open"
msgstr "Öffnen"

#. key: signin_dialog_body
msgid "Your browser should have opened to claude.ai. Complete sign-in there, then return here. This dialog will close automatically."
msgstr "Ihr Browser sollte sich auf claude.ai geöffnet haben. Schließen Sie die Anmeldung dort ab und kehren Sie dann hierher zurück. Dieses Dialogfeld wird automatisch geschlossen."

#. key: tooltip_lines
msgid "ClaudeBar\nSession: %1%%\nWeekly: %2%%"
msgstr "ClaudeBar\nSitzung: %1%%\nWöchentlich: %2%%"

#. key: installer_welcome
msgid "Welcome to the ClaudeBar Setup"
msgstr "Willkommen beim ClaudeBar-Setup"

#. key: installer_runtime_step
msgid ".NET 8 Desktop Runtime (x64)"
msgstr ".NET 8 Desktop Runtime (x64)"
