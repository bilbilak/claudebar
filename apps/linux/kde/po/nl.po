#. key: brand_name, window_preferences_title, tooltip_default, installer_app_step
#. DO NOT TRANSLATE. Keep as 'ClaudeBar' in every language.
msgid "ClaudeBar"
msgstr "ClaudeBar"

#. key: menu_refresh_now
msgid "Refresh now"
msgstr "Nu vernieuwen"

#. key: menu_open_usage_page
msgid "Open claude.ai/settings/usage"
msgstr "claude.ai/settings/usage openen"

#. key: menu_settings
msgid "Settings…"
msgstr "Instellingen…"

#. key: menu_quit
msgid "Quit ClaudeBar"
msgstr "ClaudeBar afsluiten"

#. key: menu_refresh, prefs_refresh_section
msgid "Refresh"
msgstr "Vernieuwen"

#. key: stat_session
msgid "Current session"
msgstr "Huidige sessie"

#. key: stat_session_dash
msgid "Current session: —"
msgstr "Huidige sessie: —"

#. key: stat_session_with_pct
msgid "Current session: %1%%"
msgstr "Huidige sessie: %1%%"

#. key: stat_weekly
msgid "Weekly (all models)"
msgstr "Wekelijks (alle modellen)"

#. key: stat_weekly_dash
msgid "Weekly (all models): —"
msgstr "Wekelijks (alle modellen): —"

#. key: stat_weekly_with_pct
msgid "Weekly (all models): %1%%"
msgstr "Wekelijks (alle modellen): %1%%"

#. key: stat_resets
#. %s is a time-relative string like 'in 5 min'.
msgid "Resets %1"
msgstr "Reset %1"

#. key: time_now
msgid "now"
msgstr "nu"

#. key: time_dash
msgid "—"
msgstr "—"

#. key: time_in_minutes
msgid "in %1 min"
msgstr "over %1 min"

#. key: time_in_hours
msgid "in %1h"
msgstr "over %1 u"

#. key: time_in_hours_minutes
msgid "in %1h %2m"
msgstr "over %1 u %2 min"

#. key: time_in_days
msgid "in %1d"
msgstr "over %1 d"

#. key: time_in_days_hours
msgid "in %1d %2h"
msgstr "over %1 d %2 u"

#. key: status_offline
msgid "Offline — last value may be stale"
msgstr "Offline — laatste waarde kan verouderd zijn"

#. key: status_rate_limited
msgid "Rate limited by Claude API"
msgstr "Snelheidslimiet bereikt bij Claude API"

#. key: status_unauthenticated
msgid "Not signed in — open Settings to add a token"
msgstr "Niet aangemeld — open Instellingen om een token toe te voegen"

#. key: auth_sign_in, signin_dialog_heading
msgid "Sign in with Claude"
msgstr "Aanmelden met Claude"

#. key: auth_sign_out
msgid "Sign out"
msgstr "Afmelden"

#. key: auth_signed_in_token
#. %s is the last 6 chars of the access token.
msgid "Signed in (token ends '…%1')"
msgstr "Aangemeld (token eindigt op '…%1')"

#. key: auth_not_signed_in
msgid "Not signed in"
msgstr "Niet aangemeld"

#. key: auth_checking
msgid "Checking…"
msgstr "Controleren…"

#. key: auth_waiting_browser
msgid "Waiting for browser sign-in…"
msgstr "Wachten op aanmelding via browser…"

#. key: auth_keyring_error
msgid "Keyring error — see logs"
msgstr "Sleutelringfout — zie logboek"

#. key: auth_sign_in_failed
msgid "Sign-in failed"
msgstr "Aanmelden mislukt"

#. key: auth_could_not_start
msgid "Could not start sign-in"
msgstr "Aanmelden kon niet worden gestart"

#. key: auth_copy_link
#. Short button label — used both in prefs dialogs and as a system-notification action where supported.
msgid "Copy link"
msgstr "Link kopiëren"

#. key: auth_link_copied_notify
#. Notification body shown after a menu/popup Sign-in click. Body of an OS desktop notification (libnotify on Linux). Title is the brand name.
msgid "Sign-in link copied to clipboard"
msgstr "Aanmeldlink gekopieerd naar het klembord"

#. key: prefs_account
msgid "Account"
msgstr "Account"

#. key: prefs_display
msgid "Display"
msgstr "Weergave"

#. key: prefs_advanced
msgid "Advanced"
msgstr "Geavanceerd"

#. key: prefs_general
msgid "General"
msgstr "Algemeen"

#. key: prefs_authentication
msgid "Authentication"
msgstr "Verificatie"

#. key: prefs_status
msgid "Status"
msgstr "Status"

#. key: prefs_top_bar
msgid "Top bar"
msgstr "Bovenbalk"

#. key: prefs_tray_icon
msgid "Tray icon"
msgstr "Systeemvakpictogram"

#. key: prefs_color_thresholds
msgid "Color thresholds"
msgstr "Kleurdrempels"

#. key: prefs_labels
msgid "Labels:"
msgstr "Labels:"

#. key: prefs_account_subtitle
msgid "Sign in with your Claude account to fetch Max plan usage. Tokens are stored in GNOME Keyring via libsecret."
msgstr "Meld u aan met uw Claude-account om het verbruik van het Max-abonnement op te halen. Tokens worden opgeslagen in GNOME Keyring via libsecret."

#. key: prefs_show_percentages
msgid "Show numeric percentages next to bars"
msgstr "Numerieke percentages naast de balken tonen"

#. key: prefs_show_percentages_subtitle
msgid "Small session and weekly percentages, stacked beside the bars."
msgstr "Kleine sessie- en weekpercentages, gestapeld naast de balken."

#. key: prefs_show_percentages_beside
msgid "Show numeric percentages beside the bars"
msgstr "Numerieke percentages naast de balken tonen"

#. key: prefs_color_thresholds_desc
msgid "When bars switch from green to orange to red."
msgstr "Wanneer balken van groen naar oranje en vervolgens naar rood overgaan."

#. key: prefs_orange_at
msgid "Orange at"
msgstr "Oranje bij"

#. key: prefs_red_at
msgid "Red at"
msgstr "Rood bij"

#. key: prefs_orange_at_pct
msgid "Orange at (%)"
msgstr "Oranje bij (%)"

#. key: prefs_red_at_pct
msgid "Red at (%)"
msgstr "Rood bij (%)"

#. key: prefs_orange_at_short
msgid "Orange at (%):"
msgstr "Oranje bij (%):"

#. key: prefs_red_at_short
msgid "Red at (%):"
msgstr "Rood bij (%):"

#. key: prefs_poll_interval_seconds
msgid "Poll interval (seconds)"
msgstr "Pollinginterval (seconden)"

#. key: prefs_poll_interval_short
msgid "Poll interval (s):"
msgstr "Pollinginterval (s):"

#. key: prefs_helper_path
msgid "Helper binary:"
msgstr "Helperbinary:"

#. key: meter_section
msgid "Floating desktop meter"
msgstr "Zwevende bureaubladmeter"

#. key: meter_enable
msgid "Show always-on-top meter on the desktop"
msgstr "Toon altijd-bovenop meter op het bureaublad"

#. key: meter_desc
msgid "Small transparent widget rendering full-size bars. Draggable into any corner; right-click to lock or hide."
msgstr "Klein transparant widget dat balken op volledige grootte weergeeft. Versleepbaar naar elke hoek; klik met de rechtermuisknop om te vergrendelen of te verbergen."

#. key: meter_show_percentages
msgid "Show numeric percentages on the floating meter"
msgstr "Numerieke percentages op de zwevende meter tonen"

#. key: meter_show_percentages_subtitle
msgid "Adds session and weekly percentages next to the bars on the floating desktop meter (must be enabled below). The tray tooltip always shows percentages."
msgstr "Voegt sessie- en weekpercentages toe naast de balken op de zwevende bureaubladmeter (moet hieronder ingeschakeld zijn). De tooltip in het systeemvak toont altijd percentages."

#. key: meter_opacity
msgid "Opacity:"
msgstr "Dekking:"

#. key: meter_width_px
msgid "Width (px):"
msgstr "Breedte (px):"

#. key: meter_width_hint
msgid "(120–320)"
msgstr "(120–320)"

#. key: meter_lock
msgid "Lock position"
msgstr "Positie vergrendelen"

#. key: meter_unlock
msgid "Unlock"
msgstr "Ontgrendelen"

#. key: meter_hide
msgid "Hide meter"
msgstr "Meter verbergen"

#. key: action_ok
msgid "OK"
msgstr "OK"

#. key: action_cancel
msgid "Cancel"
msgstr "Annuleren"

#. key: action_close
msgid "Close"
msgstr "Sluiten"

#. key: action_open
msgid "Open"
msgstr "Openen"

#. key: signin_dialog_body
msgid "Your browser should have opened to claude.ai. Complete sign-in there, then return here. This dialog will close automatically."
msgstr "Uw browser zou claude.ai geopend moeten hebben. Voltooi daar de aanmelding en kom dan hier terug. Dit dialoogvenster wordt automatisch gesloten."

#. key: tooltip_lines
msgid "ClaudeBar\nSession: %1%%\nWeekly: %2%%"
msgstr "ClaudeBar\nSessie: %1%%\nWekelijks: %2%%"

#. key: installer_welcome
msgid "Welcome to the ClaudeBar Setup"
msgstr "Welkom bij de installatie van ClaudeBar"

#. key: installer_runtime_step
msgid ".NET 8 Desktop Runtime (x64)"
msgstr ".NET 8 Desktop Runtime (x64)"
