#. key: brand_name, window_preferences_title, tooltip_default, installer_app_step
#. DO NOT TRANSLATE. Keep as 'ClaudeBar' in every language.
msgid "ClaudeBar"
msgstr "ClaudeBar"

#. key: menu_refresh_now
msgid "Refresh now"
msgstr "Actualiser maintenant"

#. key: menu_open_usage_page
msgid "Open claude.ai/settings/usage"
msgstr "Ouvrir claude.ai/settings/usage"

#. key: menu_settings
msgid "Settings…"
msgstr "Paramètres…"

#. key: menu_quit
msgid "Quit ClaudeBar"
msgstr "Quitter ClaudeBar"

#. key: menu_refresh, prefs_refresh_section
msgid "Refresh"
msgstr "Actualiser"

#. key: stat_session
msgid "Current session"
msgstr "Session en cours"

#. key: stat_session_dash
msgid "Current session: —"
msgstr "Session en cours : —"

#. key: stat_session_with_pct
msgid "Current session: %d%%"
msgstr "Session en cours : %d%%"

#. key: stat_weekly
msgid "Weekly (all models)"
msgstr "Hebdomadaire (tous les modèles)"

#. key: stat_weekly_dash
msgid "Weekly (all models): —"
msgstr "Hebdomadaire (tous les modèles) : —"

#. key: stat_weekly_with_pct
msgid "Weekly (all models): %d%%"
msgstr "Hebdomadaire (tous les modèles) : %d%%"

#. key: stat_resets
#. %s is a time-relative string like 'in 5 min'.
msgid "Resets %s"
msgstr "Réinitialisation %s"

#. key: time_now
msgid "now"
msgstr "maintenant"

#. key: time_dash
msgid "—"
msgstr "—"

#. key: time_in_minutes
msgid "in %d min"
msgstr "dans %d min"

#. key: time_in_hours
msgid "in %dh"
msgstr "dans %d h"

#. key: time_in_hours_minutes
msgid "in %dh %dm"
msgstr "dans %d h %d min"

#. key: time_in_days
msgid "in %dd"
msgstr "dans %d j"

#. key: time_in_days_hours
msgid "in %dd %dh"
msgstr "dans %d j %d h"

#. key: status_offline
msgid "Offline — last value may be stale"
msgstr "Hors ligne — la dernière valeur peut être obsolète"

#. key: status_rate_limited
msgid "Rate limited by Claude API"
msgstr "Limite de débit imposée par Claude API"

#. key: status_unauthenticated
msgid "Not signed in — open Settings to add a token"
msgstr "Non connecté — ouvrez les Paramètres pour ajouter un jeton"

#. key: auth_sign_in, signin_dialog_heading
msgid "Sign in with Claude"
msgstr "Se connecter avec Claude"

#. key: auth_sign_out
msgid "Sign out"
msgstr "Se déconnecter"

#. key: auth_signed_in_token
#. %s is the last 6 chars of the access token.
msgid "Signed in (token ends '…%s')"
msgstr "Connecté (le jeton se termine par « …%s »)"

#. key: auth_not_signed_in
msgid "Not signed in"
msgstr "Non connecté"

#. key: auth_checking
msgid "Checking…"
msgstr "Vérification…"

#. key: auth_waiting_browser
msgid "Waiting for browser sign-in…"
msgstr "En attente de la connexion via le navigateur…"

#. key: auth_keyring_error
msgid "Keyring error — see logs"
msgstr "Erreur du trousseau — consultez les journaux"

#. key: auth_sign_in_failed
msgid "Sign-in failed"
msgstr "Échec de la connexion"

#. key: auth_could_not_start
msgid "Could not start sign-in"
msgstr "Impossible de démarrer la connexion"

#. key: auth_copy_link
#. Short button label — used both in prefs dialogs and as a system-notification action where supported.
msgid "Copy link"
msgstr "Copier le lien"

#. key: auth_link_copied_notify
#. Notification body shown after a menu/popup Sign-in click. Body of an OS desktop notification (libnotify on Linux). Title is the brand name.
msgid "Sign-in link copied to clipboard"
msgstr "Lien de connexion copié dans le presse-papiers"

#. key: prefs_account
msgid "Account"
msgstr "Compte"

#. key: prefs_display
msgid "Display"
msgstr "Affichage"

#. key: prefs_advanced
msgid "Advanced"
msgstr "Avancé"

#. key: prefs_general
msgid "General"
msgstr "Général"

#. key: prefs_authentication
msgid "Authentication"
msgstr "Authentification"

#. key: prefs_status
msgid "Status"
msgstr "État"

#. key: prefs_top_bar
msgid "Top bar"
msgstr "Barre supérieure"

#. key: prefs_tray_icon
msgid "Tray icon"
msgstr "Icône de la barre d'état"

#. key: prefs_color_thresholds
msgid "Color thresholds"
msgstr "Seuils de couleur"

#. key: prefs_labels
msgid "Labels:"
msgstr "Étiquettes :"

#. key: prefs_account_subtitle
msgid "Sign in with your Claude account to fetch Max plan usage. Tokens are stored in GNOME Keyring via libsecret."
msgstr "Connectez-vous avec votre compte Claude pour récupérer l'utilisation du plan Max. Les jetons sont stockés dans GNOME Keyring via libsecret."

#. key: prefs_show_percentages
msgid "Show numeric percentages next to bars"
msgstr "Afficher les pourcentages numériques à côté des barres"

#. key: prefs_show_percentages_subtitle
msgid "Small session and weekly percentages, stacked beside the bars."
msgstr "Petits pourcentages de session et hebdomadaires, empilés à côté des barres."

#. key: prefs_show_percentages_beside
msgid "Show numeric percentages beside the bars"
msgstr "Afficher les pourcentages numériques à côté des barres"

#. key: prefs_color_thresholds_desc
msgid "When bars switch from green to orange to red."
msgstr "Quand les barres passent du vert à l'orange puis au rouge."

#. key: prefs_orange_at
msgid "Orange at"
msgstr "Orange à"

#. key: prefs_red_at
msgid "Red at"
msgstr "Rouge à"

#. key: prefs_orange_at_pct
msgid "Orange at (%)"
msgstr "Orange à (%)"

#. key: prefs_red_at_pct
msgid "Red at (%)"
msgstr "Rouge à (%)"

#. key: prefs_orange_at_short
msgid "Orange at (%):"
msgstr "Orange à (%) :"

#. key: prefs_red_at_short
msgid "Red at (%):"
msgstr "Rouge à (%) :"

#. key: prefs_poll_interval_seconds
msgid "Poll interval (seconds)"
msgstr "Intervalle d'interrogation (secondes)"

#. key: prefs_poll_interval_short
msgid "Poll interval (s):"
msgstr "Intervalle d'interrogation (s) :"

#. key: prefs_helper_path
msgid "Helper binary:"
msgstr "Binaire d'assistance :"

#. key: meter_section
msgid "Floating desktop meter"
msgstr "Compteur flottant sur le bureau"

#. key: meter_enable
msgid "Show always-on-top meter on the desktop"
msgstr "Afficher un compteur toujours visible sur le bureau"

#. key: meter_desc
msgid "Small transparent widget rendering full-size bars. Draggable into any corner; right-click to lock or hide."
msgstr "Petit widget transparent affichant des barres en taille réelle. Déplaçable dans n'importe quel coin ; clic droit pour le verrouiller ou le masquer."

#. key: meter_show_percentages
msgid "Show numeric percentages on the floating meter"
msgstr "Afficher les pourcentages numériques sur le compteur flottant"

#. key: meter_show_percentages_subtitle
msgid "Adds session and weekly percentages next to the bars on the floating desktop meter (must be enabled below). The tray tooltip always shows percentages."
msgstr "Ajoute les pourcentages de session et hebdomadaires à côté des barres sur le compteur flottant du bureau (doit être activé ci-dessous). L'info-bulle de la barre d'état affiche toujours les pourcentages."

#. key: meter_opacity
msgid "Opacity:"
msgstr "Opacité :"

#. key: meter_width_px
msgid "Width (px):"
msgstr "Largeur (px) :"

#. key: meter_width_hint
msgid "(120–320)"
msgstr "(120–320)"

#. key: meter_lock
msgid "Lock position"
msgstr "Verrouiller la position"

#. key: meter_unlock
msgid "Unlock"
msgstr "Déverrouiller"

#. key: meter_hide
msgid "Hide meter"
msgstr "Masquer le compteur"

#. key: action_ok
msgid "OK"
msgstr "OK"

#. key: action_cancel
msgid "Cancel"
msgstr "Annuler"

#. key: action_close
msgid "Close"
msgstr "Fermer"

#. key: action_open
msgid "Open"
msgstr "Ouvrir"

#. key: signin_dialog_body
msgid "Your browser should have opened to claude.ai. Complete sign-in there, then return here. This dialog will close automatically."
msgstr "Votre navigateur devrait s'être ouvert sur claude.ai. Terminez la connexion là-bas, puis revenez ici. Cette boîte de dialogue se fermera automatiquement."

#. key: tooltip_lines
msgid "ClaudeBar\nSession: %d%%\nWeekly: %d%%"
msgstr "ClaudeBar\nSession : %d%%\nHebdomadaire : %d%%"

#. key: installer_welcome
msgid "Welcome to the ClaudeBar Setup"
msgstr "Bienvenue dans l'installation de ClaudeBar"

#. key: installer_runtime_step
msgid ".NET 8 Desktop Runtime (x64)"
msgstr ".NET 8 Desktop Runtime (x64)"
