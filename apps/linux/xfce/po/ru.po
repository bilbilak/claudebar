#. key: brand_name, window_preferences_title, tooltip_default, installer_app_step
#. DO NOT TRANSLATE. Keep as 'ClaudeBar' in every language.
msgid "ClaudeBar"
msgstr "ClaudeBar"

#. key: menu_refresh_now
msgid "Refresh now"
msgstr "Обновить сейчас"

#. key: menu_open_usage_page
msgid "Open claude.ai/settings/usage"
msgstr "Открыть claude.ai/settings/usage"

#. key: menu_settings
msgid "Settings…"
msgstr "Настройки…"

#. key: menu_quit
msgid "Quit ClaudeBar"
msgstr "Закрыть ClaudeBar"

#. key: menu_refresh, prefs_refresh_section
msgid "Refresh"
msgstr "Обновить"

#. key: stat_session
msgid "Current session"
msgstr "Текущая сессия"

#. key: stat_session_dash
msgid "Current session: —"
msgstr "Текущая сессия: —"

#. key: stat_session_with_pct
msgid "Current session: %d%%"
msgstr "Текущая сессия: %d%%"

#. key: stat_weekly
msgid "Weekly (all models)"
msgstr "За неделю (все модели)"

#. key: stat_weekly_dash
msgid "Weekly (all models): —"
msgstr "За неделю (все модели): —"

#. key: stat_weekly_with_pct
msgid "Weekly (all models): %d%%"
msgstr "За неделю (все модели): %d%%"

#. key: stat_resets
#. %s is a time-relative string like 'in 5 min'.
msgid "Resets %s"
msgstr "Сброс %s"

#. key: time_now
msgid "now"
msgstr "сейчас"

#. key: time_dash
msgid "—"
msgstr "—"

#. key: time_in_minutes
msgid "in %d min"
msgstr "через %d мин"

#. key: time_in_hours
msgid "in %dh"
msgstr "через %d ч"

#. key: time_in_hours_minutes
msgid "in %dh %dm"
msgstr "через %d ч %d мин"

#. key: time_in_days
msgid "in %dd"
msgstr "через %d дн"

#. key: time_in_days_hours
msgid "in %dd %dh"
msgstr "через %d дн %d ч"

#. key: status_offline
msgid "Offline — last value may be stale"
msgstr "Нет подключения — последнее значение может быть устаревшим"

#. key: status_rate_limited
msgid "Rate limited by Claude API"
msgstr "Превышен лимит запросов Claude API"

#. key: status_unauthenticated
msgid "Not signed in — open Settings to add a token"
msgstr "Вы не вошли — откройте Настройки, чтобы добавить токен"

#. key: auth_sign_in, signin_dialog_heading
msgid "Sign in with Claude"
msgstr "Войти через Claude"

#. key: auth_sign_out
msgid "Sign out"
msgstr "Выйти"

#. key: auth_signed_in_token
#. %s is the last 6 chars of the access token.
msgid "Signed in (token ends '…%s')"
msgstr "Выполнен вход (токен заканчивается на «…%s»)"

#. key: auth_not_signed_in
msgid "Not signed in"
msgstr "Не выполнен вход"

#. key: auth_checking
msgid "Checking…"
msgstr "Проверка…"

#. key: auth_waiting_browser
msgid "Waiting for browser sign-in…"
msgstr "Ожидание входа в браузере…"

#. key: auth_keyring_error
msgid "Keyring error — see logs"
msgstr "Ошибка хранилища ключей — см. журналы"

#. key: auth_sign_in_failed
msgid "Sign-in failed"
msgstr "Не удалось войти"

#. key: auth_could_not_start
msgid "Could not start sign-in"
msgstr "Не удалось запустить вход"

#. key: auth_copy_link
#. Short button label — used both in prefs dialogs and as a system-notification action where supported.
msgid "Copy link"
msgstr "Копировать ссылку"

#. key: auth_link_copied_notify
#. Notification body shown after a menu/popup Sign-in click. Body of an OS desktop notification (libnotify on Linux). Title is the brand name.
msgid "Sign-in link copied to clipboard"
msgstr "Ссылка для входа скопирована в буфер обмена"

#. key: prefs_account
msgid "Account"
msgstr "Учётная запись"

#. key: prefs_display
msgid "Display"
msgstr "Отображение"

#. key: prefs_advanced
msgid "Advanced"
msgstr "Дополнительно"

#. key: prefs_general
msgid "General"
msgstr "Общие"

#. key: prefs_authentication
msgid "Authentication"
msgstr "Аутентификация"

#. key: prefs_status
msgid "Status"
msgstr "Состояние"

#. key: prefs_top_bar
msgid "Top bar"
msgstr "Верхняя панель"

#. key: prefs_tray_icon
msgid "Tray icon"
msgstr "Значок в трее"

#. key: prefs_color_thresholds
msgid "Color thresholds"
msgstr "Цветовые пороги"

#. key: prefs_labels
msgid "Labels:"
msgstr "Метки:"

#. key: prefs_account_subtitle
msgid "Sign in with your Claude account to fetch Max plan usage. Tokens are stored in GNOME Keyring via libsecret."
msgstr "Войдите со своей учётной записью Claude, чтобы получить данные об использовании тарифа Max. Токены сохраняются в GNOME Keyring через libsecret."

#. key: prefs_show_percentages
msgid "Show numeric percentages next to bars"
msgstr "Показывать числовые проценты рядом с полосами"

#. key: prefs_show_percentages_subtitle
msgid "Small session and weekly percentages, stacked beside the bars."
msgstr "Небольшие проценты сессии и недели, расположенные рядом с полосами."

#. key: prefs_show_percentages_beside
msgid "Show numeric percentages beside the bars"
msgstr "Показывать числовые проценты рядом с полосами"

#. key: prefs_color_thresholds_desc
msgid "When bars switch from green to orange to red."
msgstr "Когда полосы меняют цвет с зелёного на оранжевый, затем на красный."

#. key: prefs_orange_at
msgid "Orange at"
msgstr "Оранжевый при"

#. key: prefs_red_at
msgid "Red at"
msgstr "Красный при"

#. key: prefs_orange_at_pct
msgid "Orange at (%)"
msgstr "Оранжевый при (%)"

#. key: prefs_red_at_pct
msgid "Red at (%)"
msgstr "Красный при (%)"

#. key: prefs_orange_at_short
msgid "Orange at (%):"
msgstr "Оранжевый при (%):"

#. key: prefs_red_at_short
msgid "Red at (%):"
msgstr "Красный при (%):"

#. key: prefs_poll_interval_seconds
msgid "Poll interval (seconds)"
msgstr "Интервал опроса (секунды)"

#. key: prefs_poll_interval_short
msgid "Poll interval (s):"
msgstr "Интервал опроса (с):"

#. key: prefs_helper_path
msgid "Helper binary:"
msgstr "Вспомогательный двоичный файл:"

#. key: meter_section
msgid "Floating desktop meter"
msgstr "Плавающий индикатор на рабочем столе"

#. key: meter_enable
msgid "Show always-on-top meter on the desktop"
msgstr "Показывать индикатор поверх всех окон на рабочем столе"

#. key: meter_desc
msgid "Small transparent widget rendering full-size bars. Draggable into any corner; right-click to lock or hide."
msgstr "Небольшой прозрачный виджет с полноразмерными полосами. Можно перетащить в любой угол; правый клик — закрепить или скрыть."

#. key: meter_show_percentages
msgid "Show numeric percentages on the floating meter"
msgstr "Показывать числовые проценты на плавающем индикаторе"

#. key: meter_show_percentages_subtitle
msgid "Adds session and weekly percentages next to the bars on the floating desktop meter (must be enabled below). The tray tooltip always shows percentages."
msgstr "Добавляет проценты сессии и недели рядом с полосами на плавающем индикаторе рабочего стола (должен быть включён ниже). Подсказка в трее всегда показывает проценты."

#. key: meter_opacity
msgid "Opacity:"
msgstr "Непрозрачность:"

#. key: meter_width_px
msgid "Width (px):"
msgstr "Ширина (пикс.):"

#. key: meter_width_hint
msgid "(120–320)"
msgstr "(120–320)"

#. key: meter_lock
msgid "Lock position"
msgstr "Зафиксировать положение"

#. key: meter_unlock
msgid "Unlock"
msgstr "Снять блокировку"

#. key: meter_hide
msgid "Hide meter"
msgstr "Скрыть индикатор"

#. key: action_ok
msgid "OK"
msgstr "ОК"

#. key: action_cancel
msgid "Cancel"
msgstr "Отмена"

#. key: action_close
msgid "Close"
msgstr "Закрыть"

#. key: action_open
msgid "Open"
msgstr "Открыть"

#. key: signin_dialog_body
msgid "Your browser should have opened to claude.ai. Complete sign-in there, then return here. This dialog will close automatically."
msgstr "Ваш браузер должен был открыть claude.ai. Завершите вход там и вернитесь сюда. Это диалоговое окно закроется автоматически."

#. key: tooltip_lines
msgid "ClaudeBar\nSession: %d%%\nWeekly: %d%%"
msgstr "ClaudeBar\nСессия: %d%%\nЗа неделю: %d%%"

#. key: installer_welcome
msgid "Welcome to the ClaudeBar Setup"
msgstr "Добро пожаловать в установку ClaudeBar"

#. key: installer_runtime_step
msgid ".NET 8 Desktop Runtime (x64)"
msgstr ".NET 8 Desktop Runtime (x64)"
