#. key: brand_name, window_preferences_title, tooltip_default, installer_app_step
#. DO NOT TRANSLATE. Keep as 'ClaudeBar' in every language.
msgid "ClaudeBar"
msgstr "ClaudeBar"

#. key: menu_refresh_now
msgid "Refresh now"
msgstr "Atualizar agora"

#. key: menu_open_usage_page
msgid "Open claude.ai/settings/usage"
msgstr "Abrir claude.ai/settings/usage"

#. key: menu_settings
msgid "Settings…"
msgstr "Definições…"

#. key: menu_quit
msgid "Quit ClaudeBar"
msgstr "Sair do ClaudeBar"

#. key: menu_refresh, prefs_refresh_section
msgid "Refresh"
msgstr "Atualizar"

#. key: stat_session
msgid "Current session"
msgstr "Sessão atual"

#. key: stat_session_dash
msgid "Current session: —"
msgstr "Sessão atual: —"

#. key: stat_session_with_pct
msgid "Current session: %d%%"
msgstr "Sessão atual: %d%%"

#. key: stat_weekly
msgid "Weekly (all models)"
msgstr "Semanal (todos os modelos)"

#. key: stat_weekly_dash
msgid "Weekly (all models): —"
msgstr "Semanal (todos os modelos): —"

#. key: stat_weekly_with_pct
msgid "Weekly (all models): %d%%"
msgstr "Semanal (todos os modelos): %d%%"

#. key: stat_resets
#. %s is a time-relative string like 'in 5 min'.
msgid "Resets %s"
msgstr "Reinicia %s"

#. key: time_now
msgid "now"
msgstr "agora"

#. key: time_dash
msgid "—"
msgstr "—"

#. key: time_in_minutes
msgid "in %d min"
msgstr "em %d min"

#. key: time_in_hours
msgid "in %dh"
msgstr "em %d h"

#. key: time_in_hours_minutes
msgid "in %dh %dm"
msgstr "em %d h %d min"

#. key: time_in_days
msgid "in %dd"
msgstr "em %d d"

#. key: time_in_days_hours
msgid "in %dd %dh"
msgstr "em %d d %d h"

#. key: status_offline
msgid "Offline — last value may be stale"
msgstr "Offline — o último valor pode estar desatualizado"

#. key: status_rate_limited
msgid "Rate limited by Claude API"
msgstr "Limite de taxa atingido pela Claude API"

#. key: status_unauthenticated
msgid "Not signed in — open Settings to add a token"
msgstr "Sessão não iniciada — abra Definições para adicionar um token"

#. key: auth_sign_in, signin_dialog_heading
msgid "Sign in with Claude"
msgstr "Iniciar sessão com Claude"

#. key: auth_sign_out
msgid "Sign out"
msgstr "Terminar sessão"

#. key: auth_signed_in_token
#. %s is the last 6 chars of the access token.
msgid "Signed in (token ends '…%s')"
msgstr "Sessão iniciada (o token termina em «…%s»)"

#. key: auth_not_signed_in
msgid "Not signed in"
msgstr "Sessão não iniciada"

#. key: auth_checking
msgid "Checking…"
msgstr "A verificar…"

#. key: auth_waiting_browser
msgid "Waiting for browser sign-in…"
msgstr "À espera do início de sessão no navegador…"

#. key: auth_keyring_error
msgid "Keyring error — see logs"
msgstr "Erro do porta-chaves — consulte os registos"

#. key: auth_sign_in_failed
msgid "Sign-in failed"
msgstr "Falha ao iniciar sessão"

#. key: auth_could_not_start
msgid "Could not start sign-in"
msgstr "Não foi possível iniciar a sessão"

#. key: auth_copy_link
#. Short button label — used both in prefs dialogs and as a system-notification action where supported.
msgid "Copy link"
msgstr "Copiar ligação"

#. key: auth_link_copied_notify
#. Notification body shown after a menu/popup Sign-in click. Body of an OS desktop notification (libnotify on Linux). Title is the brand name.
msgid "Sign-in link copied to clipboard"
msgstr "Ligação de início de sessão copiada para a área de transferência"

#. key: prefs_account
msgid "Account"
msgstr "Conta"

#. key: prefs_display
msgid "Display"
msgstr "Apresentação"

#. key: prefs_advanced
msgid "Advanced"
msgstr "Avançado"

#. key: prefs_general
msgid "General"
msgstr "Geral"

#. key: prefs_authentication
msgid "Authentication"
msgstr "Autenticação"

#. key: prefs_status
msgid "Status"
msgstr "Estado"

#. key: prefs_top_bar
msgid "Top bar"
msgstr "Barra superior"

#. key: prefs_tray_icon
msgid "Tray icon"
msgstr "Ícone da bandeja"

#. key: prefs_color_thresholds
msgid "Color thresholds"
msgstr "Limiares de cor"

#. key: prefs_labels
msgid "Labels:"
msgstr "Etiquetas:"

#. key: prefs_account_subtitle
msgid "Sign in with your Claude account to fetch Max plan usage. Tokens are stored in GNOME Keyring via libsecret."
msgstr "Inicie sessão com a sua conta Claude para obter a utilização do plano Max. Os tokens são armazenados no GNOME Keyring através do libsecret."

#. key: prefs_show_percentages
msgid "Show numeric percentages next to bars"
msgstr "Mostrar percentagens numéricas ao lado das barras"

#. key: prefs_show_percentages_subtitle
msgid "Small session and weekly percentages, stacked beside the bars."
msgstr "Pequenas percentagens da sessão e semanais, empilhadas ao lado das barras."

#. key: prefs_show_percentages_beside
msgid "Show numeric percentages beside the bars"
msgstr "Mostrar percentagens numéricas ao lado das barras"

#. key: prefs_color_thresholds_desc
msgid "When bars switch from green to orange to red."
msgstr "Quando as barras passam de verde para laranja e depois para vermelho."

#. key: prefs_orange_at
msgid "Orange at"
msgstr "Laranja em"

#. key: prefs_red_at
msgid "Red at"
msgstr "Vermelho em"

#. key: prefs_orange_at_pct
msgid "Orange at (%)"
msgstr "Laranja em (%)"

#. key: prefs_red_at_pct
msgid "Red at (%)"
msgstr "Vermelho em (%)"

#. key: prefs_orange_at_short
msgid "Orange at (%):"
msgstr "Laranja em (%):"

#. key: prefs_red_at_short
msgid "Red at (%):"
msgstr "Vermelho em (%):"

#. key: prefs_poll_interval_seconds
msgid "Poll interval (seconds)"
msgstr "Intervalo de sondagem (segundos)"

#. key: prefs_poll_interval_short
msgid "Poll interval (s):"
msgstr "Intervalo de sondagem (s):"

#. key: prefs_helper_path
msgid "Helper binary:"
msgstr "Binário auxiliar:"

#. key: meter_section
msgid "Floating desktop meter"
msgstr "Medidor flutuante no ambiente de trabalho"

#. key: meter_enable
msgid "Show always-on-top meter on the desktop"
msgstr "Mostrar um medidor sempre visível no ambiente de trabalho"

#. key: meter_desc
msgid "Small transparent widget rendering full-size bars. Draggable into any corner; right-click to lock or hide."
msgstr "Pequeno widget transparente que apresenta barras em tamanho real. Pode ser arrastado para qualquer canto; clique com o botão direito para bloquear ou ocultar."

#. key: meter_show_percentages
msgid "Show numeric percentages on the floating meter"
msgstr "Mostrar percentagens numéricas no medidor flutuante"

#. key: meter_show_percentages_subtitle
msgid "Adds session and weekly percentages next to the bars on the floating desktop meter (must be enabled below). The tray tooltip always shows percentages."
msgstr "Adiciona as percentagens de sessão e semanais ao lado das barras no medidor flutuante do ambiente de trabalho (deve estar ativado abaixo). A dica de ferramenta da bandeja mostra sempre as percentagens."

#. key: meter_opacity
msgid "Opacity:"
msgstr "Opacidade:"

#. key: meter_width_px
msgid "Width (px):"
msgstr "Largura (px):"

#. key: meter_width_hint
msgid "(120–320)"
msgstr "(120–320)"

#. key: meter_lock
msgid "Lock position"
msgstr "Bloquear posição"

#. key: meter_unlock
msgid "Unlock"
msgstr "Desbloquear"

#. key: meter_hide
msgid "Hide meter"
msgstr "Ocultar medidor"

#. key: action_ok
msgid "OK"
msgstr "OK"

#. key: action_cancel
msgid "Cancel"
msgstr "Cancelar"

#. key: action_close
msgid "Close"
msgstr "Fechar"

#. key: action_open
msgid "Open"
msgstr "Abrir"

#. key: signin_dialog_body
msgid "Your browser should have opened to claude.ai. Complete sign-in there, then return here. This dialog will close automatically."
msgstr "O seu navegador deverá ter aberto em claude.ai. Conclua o início de sessão aí e regresse a esta janela. Esta caixa de diálogo será fechada automaticamente."

#. key: tooltip_lines
msgid "ClaudeBar\nSession: %d%%\nWeekly: %d%%"
msgstr "ClaudeBar\nSessão: %d%%\nSemanal: %d%%"

#. key: installer_welcome
msgid "Welcome to the ClaudeBar Setup"
msgstr "Bem-vindo à configuração do ClaudeBar"

#. key: installer_runtime_step
msgid ".NET 8 Desktop Runtime (x64)"
msgstr ".NET 8 Desktop Runtime (x64)"
