# Compile each <lang>.po into a .mo and install it as
# ${localedir}/<lang>/LC_MESSAGES/claudebar.mo.
#
# The .pot and .po files in this directory are generated by:
#   python3 scripts/regenerate-translations.py xfce
# (run from the repo root). Do not hand-edit them — edit i18n/strings.yaml
# and re-run the script.
#
# Supported languages are listed one-per-line in LINGUAS.

i18n = import('i18n')

i18n.gettext(
  gettext_domain,
  preset: 'glib',
  args: [
    '--from-code=UTF-8',
    '--keyword=_',
    '--keyword=N_',
  ],
)
