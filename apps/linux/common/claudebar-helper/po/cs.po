#. key: brand_name, window_preferences_title, tooltip_default, installer_app_step
#. DO NOT TRANSLATE. Keep as 'ClaudeBar' in every language.
msgid "ClaudeBar"
msgstr "ClaudeBar"

#. key: menu_refresh_now
msgid "Refresh now"
msgstr "Aktualizovat nyní"

#. key: menu_open_usage_page
msgid "Open claude.ai/settings/usage"
msgstr "Otevřít claude.ai/settings/usage"

#. key: menu_settings
msgid "Settings…"
msgstr "Nastavení…"

#. key: menu_quit
msgid "Quit ClaudeBar"
msgstr "Ukončit ClaudeBar"

#. key: menu_refresh, prefs_refresh_section
msgid "Refresh"
msgstr "Aktualizovat"

#. key: stat_session
msgid "Current session"
msgstr "Aktuální relace"

#. key: stat_session_dash
msgid "Current session: —"
msgstr "Aktuální relace: —"

#. key: stat_session_with_pct
msgid "Current session: %d%%"
msgstr "Aktuální relace: %d%%"

#. key: stat_weekly
msgid "Weekly (all models)"
msgstr "Týdně (všechny modely)"

#. key: stat_weekly_dash
msgid "Weekly (all models): —"
msgstr "Týdně (všechny modely): —"

#. key: stat_weekly_with_pct
msgid "Weekly (all models): %d%%"
msgstr "Týdně (všechny modely): %d%%"

#. key: stat_resets
#. %s is a time-relative string like 'in 5 min'.
msgid "Resets %s"
msgstr "Obnoví se %s"

#. key: time_now
msgid "now"
msgstr "nyní"

#. key: time_dash
msgid "—"
msgstr "—"

#. key: time_in_minutes
msgid "in %d min"
msgstr "za %d min"

#. key: time_in_hours
msgid "in %dh"
msgstr "za %d h"

#. key: time_in_hours_minutes
msgid "in %dh %dm"
msgstr "za %d h %d min"

#. key: time_in_days
msgid "in %dd"
msgstr "za %d d"

#. key: time_in_days_hours
msgid "in %dd %dh"
msgstr "za %d d %d h"

#. key: status_offline
msgid "Offline — last value may be stale"
msgstr "Offline — poslední hodnota může být zastaralá"

#. key: status_rate_limited
msgid "Rate limited by Claude API"
msgstr "Omezeno rychlostním limitem Claude API"

#. key: status_unauthenticated
msgid "Not signed in — open Settings to add a token"
msgstr "Nepřihlášeno — otevřete Nastavení a přidejte token"

#. key: auth_sign_in, signin_dialog_heading
msgid "Sign in with Claude"
msgstr "Přihlásit se přes Claude"

#. key: auth_sign_out
msgid "Sign out"
msgstr "Odhlásit se"

#. key: auth_signed_in_token
#. %s is the last 6 chars of the access token.
msgid "Signed in (token ends '…%s')"
msgstr "Přihlášeno (token končí na '…%s')"

#. key: auth_not_signed_in
msgid "Not signed in"
msgstr "Nepřihlášeno"

#. key: auth_checking
msgid "Checking…"
msgstr "Ověřuje se…"

#. key: auth_waiting_browser
msgid "Waiting for browser sign-in…"
msgstr "Čeká se na přihlášení v prohlížeči…"

#. key: auth_keyring_error
msgid "Keyring error — see logs"
msgstr "Chyba klíčenky — viz protokoly"

#. key: auth_sign_in_failed
msgid "Sign-in failed"
msgstr "Přihlášení se nezdařilo"

#. key: auth_could_not_start
msgid "Could not start sign-in"
msgstr "Přihlašování nelze spustit"

#. key: auth_copy_link
#. Short button label — used both in prefs dialogs and as a system-notification action where supported.
msgid "Copy link"
msgstr "Kopírovat odkaz"

#. key: auth_link_copied_notify
#. Notification body shown after a menu/popup Sign-in click. Body of an OS desktop notification (libnotify on Linux). Title is the brand name.
msgid "Sign-in link copied to clipboard"
msgstr "Přihlašovací odkaz zkopírován do schránky"

#. key: prefs_account
msgid "Account"
msgstr "Účet"

#. key: prefs_display
msgid "Display"
msgstr "Zobrazení"

#. key: prefs_advanced
msgid "Advanced"
msgstr "Pokročilé"

#. key: prefs_general
msgid "General"
msgstr "Obecné"

#. key: prefs_authentication
msgid "Authentication"
msgstr "Ověřování"

#. key: prefs_status
msgid "Status"
msgstr "Stav"

#. key: prefs_top_bar
msgid "Top bar"
msgstr "Horní lišta"

#. key: prefs_tray_icon
msgid "Tray icon"
msgstr "Ikona v oznamovací oblasti"

#. key: prefs_color_thresholds
msgid "Color thresholds"
msgstr "Barevné prahy"

#. key: prefs_labels
msgid "Labels:"
msgstr "Popisky:"

#. key: prefs_account_subtitle
msgid "Sign in with your Claude account to fetch Max plan usage. Tokens are stored in GNOME Keyring via libsecret."
msgstr "Přihlaste se svým účtem Claude, abyste získali přehled o využití plánu Max. Tokeny se ukládají do GNOME Keyring prostřednictvím knihovny libsecret."

#. key: prefs_show_percentages
msgid "Show numeric percentages next to bars"
msgstr "Zobrazit číselné procentní hodnoty vedle pruhů"

#. key: prefs_show_percentages_subtitle
msgid "Small session and weekly percentages, stacked beside the bars."
msgstr "Malé procentní hodnoty relace a týdne naskládané vedle pruhů."

#. key: prefs_show_percentages_beside
msgid "Show numeric percentages beside the bars"
msgstr "Zobrazit číselné procentní hodnoty vedle pruhů"

#. key: prefs_color_thresholds_desc
msgid "When bars switch from green to orange to red."
msgstr "Kdy pruhy přejdou ze zelené přes oranžovou až na červenou."

#. key: prefs_orange_at
msgid "Orange at"
msgstr "Oranžová při"

#. key: prefs_red_at
msgid "Red at"
msgstr "Červená při"

#. key: prefs_orange_at_pct
msgid "Orange at (%)"
msgstr "Oranžová při (%)"

#. key: prefs_red_at_pct
msgid "Red at (%)"
msgstr "Červená při (%)"

#. key: prefs_orange_at_short
msgid "Orange at (%):"
msgstr "Oranžová při (%):"

#. key: prefs_red_at_short
msgid "Red at (%):"
msgstr "Červená při (%):"

#. key: prefs_poll_interval_seconds
msgid "Poll interval (seconds)"
msgstr "Interval dotazování (sekundy)"

#. key: prefs_poll_interval_short
msgid "Poll interval (s):"
msgstr "Interval dotazování (s):"

#. key: prefs_helper_path
msgid "Helper binary:"
msgstr "Pomocný binární soubor:"

#. key: meter_section
msgid "Floating desktop meter"
msgstr "Plovoucí měřič na ploše"

#. key: meter_enable
msgid "Show always-on-top meter on the desktop"
msgstr "Zobrazit měřič vždy navrchu na ploše"

#. key: meter_desc
msgid "Small transparent widget rendering full-size bars. Draggable into any corner; right-click to lock or hide."
msgstr "Malý průhledný widget zobrazující pruhy v plné velikosti. Lze jej přetáhnout do libovolného rohu; kliknutím pravým tlačítkem jej uzamknete nebo skryjete."

#. key: meter_show_percentages
msgid "Show numeric percentages on the floating meter"
msgstr "Zobrazit číselné procentní hodnoty na plovoucím měřiči"

#. key: meter_show_percentages_subtitle
msgid "Adds session and weekly percentages next to the bars on the floating desktop meter (must be enabled below). The tray tooltip always shows percentages."
msgstr "Přidá procentní hodnoty relace a týdne vedle pruhů na plovoucím měřiči na ploše (musí být povoleno níže). Popisek v oznamovací oblasti zobrazuje procenta vždy."

#. key: meter_opacity
msgid "Opacity:"
msgstr "Krytí:"

#. key: meter_width_px
msgid "Width (px):"
msgstr "Šířka (px):"

#. key: meter_width_hint
msgid "(120–320)"
msgstr "(120–320)"

#. key: meter_lock
msgid "Lock position"
msgstr "Uzamknout polohu"

#. key: meter_unlock
msgid "Unlock"
msgstr "Odemknout"

#. key: meter_hide
msgid "Hide meter"
msgstr "Skrýt měřič"

#. key: action_ok
msgid "OK"
msgstr "OK"

#. key: action_cancel
msgid "Cancel"
msgstr "Zrušit"

#. key: action_close
msgid "Close"
msgstr "Zavřít"

#. key: action_open
msgid "Open"
msgstr "Otevřít"

#. key: signin_dialog_body
msgid "Your browser should have opened to claude.ai. Complete sign-in there, then return here. This dialog will close automatically."
msgstr "Váš prohlížeč by se měl otevřít na claude.ai. Dokončete tam přihlášení a poté se vraťte sem. Toto dialogové okno se automaticky zavře."

#. key: tooltip_lines
msgid "ClaudeBar\nSession: %d%%\nWeekly: %d%%"
msgstr "ClaudeBar\nRelace: %d%%\nTýdně: %d%%"

#. key: installer_welcome
msgid "Welcome to the ClaudeBar Setup"
msgstr "Vítejte v instalaci ClaudeBar"

#. key: installer_runtime_step
msgid ".NET 8 Desktop Runtime (x64)"
msgstr ".NET 8 Desktop Runtime (x64)"
