#. key: brand_name, window_preferences_title, tooltip_default, installer_app_step
#. DO NOT TRANSLATE. Keep as 'ClaudeBar' in every language.
msgid "ClaudeBar"
msgstr "ClaudeBar"

#. key: menu_refresh_now
msgid "Refresh now"
msgstr "Odśwież teraz"

#. key: menu_open_usage_page
msgid "Open claude.ai/settings/usage"
msgstr "Otwórz claude.ai/settings/usage"

#. key: menu_settings
msgid "Settings…"
msgstr "Ustawienia…"

#. key: menu_quit
msgid "Quit ClaudeBar"
msgstr "Zakończ ClaudeBar"

#. key: menu_refresh, prefs_refresh_section
msgid "Refresh"
msgstr "Odśwież"

#. key: stat_session
msgid "Current session"
msgstr "Bieżąca sesja"

#. key: stat_session_dash
msgid "Current session: —"
msgstr "Bieżąca sesja: —"

#. key: stat_session_with_pct
msgid "Current session: %d%%"
msgstr "Bieżąca sesja: %d%%"

#. key: stat_weekly
msgid "Weekly (all models)"
msgstr "Tygodniowo (wszystkie modele)"

#. key: stat_weekly_dash
msgid "Weekly (all models): —"
msgstr "Tygodniowo (wszystkie modele): —"

#. key: stat_weekly_with_pct
msgid "Weekly (all models): %d%%"
msgstr "Tygodniowo (wszystkie modele): %d%%"

#. key: stat_resets
#. %s is a time-relative string like 'in 5 min'.
msgid "Resets %s"
msgstr "Resetuje się %s"

#. key: time_now
msgid "now"
msgstr "teraz"

#. key: time_dash
msgid "—"
msgstr "—"

#. key: time_in_minutes
msgid "in %d min"
msgstr "za %d min"

#. key: time_in_hours
msgid "in %dh"
msgstr "za %d godz."

#. key: time_in_hours_minutes
msgid "in %dh %dm"
msgstr "za %d godz. %d min"

#. key: time_in_days
msgid "in %dd"
msgstr "za %d dni"

#. key: time_in_days_hours
msgid "in %dd %dh"
msgstr "za %d dni %d godz."

#. key: status_offline
msgid "Offline — last value may be stale"
msgstr "Offline — ostatnia wartość może być nieaktualna"

#. key: status_rate_limited
msgid "Rate limited by Claude API"
msgstr "Osiągnięto limit zapytań Claude API"

#. key: status_unauthenticated
msgid "Not signed in — open Settings to add a token"
msgstr "Nie zalogowano — otwórz Ustawienia, aby dodać token"

#. key: auth_sign_in, signin_dialog_heading
msgid "Sign in with Claude"
msgstr "Zaloguj się przez Claude"

#. key: auth_sign_out
msgid "Sign out"
msgstr "Wyloguj się"

#. key: auth_signed_in_token
#. %s is the last 6 chars of the access token.
msgid "Signed in (token ends '…%s')"
msgstr "Zalogowano (token kończy się na '…%s')"

#. key: auth_not_signed_in
msgid "Not signed in"
msgstr "Niezalogowany"

#. key: auth_checking
msgid "Checking…"
msgstr "Sprawdzanie…"

#. key: auth_waiting_browser
msgid "Waiting for browser sign-in…"
msgstr "Oczekiwanie na zalogowanie w przeglądarce…"

#. key: auth_keyring_error
msgid "Keyring error — see logs"
msgstr "Błąd pęku kluczy — zobacz dzienniki"

#. key: auth_sign_in_failed
msgid "Sign-in failed"
msgstr "Logowanie nie powiodło się"

#. key: auth_could_not_start
msgid "Could not start sign-in"
msgstr "Nie udało się rozpocząć logowania"

#. key: auth_copy_link
#. Short button label — used both in prefs dialogs and as a system-notification action where supported.
msgid "Copy link"
msgstr "Kopiuj link"

#. key: auth_link_copied_notify
#. Notification body shown after a menu/popup Sign-in click. Body of an OS desktop notification (libnotify on Linux). Title is the brand name.
msgid "Sign-in link copied to clipboard"
msgstr "Link logowania skopiowany do schowka"

#. key: prefs_account
msgid "Account"
msgstr "Konto"

#. key: prefs_display
msgid "Display"
msgstr "Wyświetlanie"

#. key: prefs_advanced
msgid "Advanced"
msgstr "Zaawansowane"

#. key: prefs_general
msgid "General"
msgstr "Ogólne"

#. key: prefs_authentication
msgid "Authentication"
msgstr "Uwierzytelnianie"

#. key: prefs_status
msgid "Status"
msgstr "Stan"

#. key: prefs_top_bar
msgid "Top bar"
msgstr "Górny pasek"

#. key: prefs_tray_icon
msgid "Tray icon"
msgstr "Ikona w zasobniku"

#. key: prefs_color_thresholds
msgid "Color thresholds"
msgstr "Progi kolorów"

#. key: prefs_labels
msgid "Labels:"
msgstr "Etykiety:"

#. key: prefs_account_subtitle
msgid "Sign in with your Claude account to fetch Max plan usage. Tokens are stored in GNOME Keyring via libsecret."
msgstr "Zaloguj się przy użyciu konta Claude, aby pobrać zużycie w planie Max. Tokeny są przechowywane w GNOME Keyring za pośrednictwem libsecret."

#. key: prefs_show_percentages
msgid "Show numeric percentages next to bars"
msgstr "Pokazuj wartości procentowe obok pasków"

#. key: prefs_show_percentages_subtitle
msgid "Small session and weekly percentages, stacked beside the bars."
msgstr "Niewielkie wartości procentowe sesji i tygodnia, ułożone obok pasków."

#. key: prefs_show_percentages_beside
msgid "Show numeric percentages beside the bars"
msgstr "Pokazuj wartości procentowe obok pasków"

#. key: prefs_color_thresholds_desc
msgid "When bars switch from green to orange to red."
msgstr "Kiedy paski zmieniają kolor z zielonego na pomarańczowy, a następnie czerwony."

#. key: prefs_orange_at
msgid "Orange at"
msgstr "Pomarańczowy przy"

#. key: prefs_red_at
msgid "Red at"
msgstr "Czerwony przy"

#. key: prefs_orange_at_pct
msgid "Orange at (%)"
msgstr "Pomarańczowy przy (%)"

#. key: prefs_red_at_pct
msgid "Red at (%)"
msgstr "Czerwony przy (%)"

#. key: prefs_orange_at_short
msgid "Orange at (%):"
msgstr "Pomarańczowy przy (%):"

#. key: prefs_red_at_short
msgid "Red at (%):"
msgstr "Czerwony przy (%):"

#. key: prefs_poll_interval_seconds
msgid "Poll interval (seconds)"
msgstr "Interwał odpytywania (sekundy)"

#. key: prefs_poll_interval_short
msgid "Poll interval (s):"
msgstr "Interwał odpytywania (s):"

#. key: prefs_helper_path
msgid "Helper binary:"
msgstr "Plik binarny pomocnika:"

#. key: meter_section
msgid "Floating desktop meter"
msgstr "Pływający miernik na pulpicie"

#. key: meter_enable
msgid "Show always-on-top meter on the desktop"
msgstr "Pokaż miernik zawsze na wierzchu na pulpicie"

#. key: meter_desc
msgid "Small transparent widget rendering full-size bars. Draggable into any corner; right-click to lock or hide."
msgstr "Mały przezroczysty widżet wyświetlający paski w pełnym rozmiarze. Można go przeciągnąć w dowolny róg; kliknij prawym przyciskiem myszy, aby zablokować lub ukryć."

#. key: meter_show_percentages
msgid "Show numeric percentages on the floating meter"
msgstr "Pokaż wartości procentowe na pływającym mierniku"

#. key: meter_show_percentages_subtitle
msgid "Adds session and weekly percentages next to the bars on the floating desktop meter (must be enabled below). The tray tooltip always shows percentages."
msgstr "Dodaje procenty sesji i tygodnia obok pasków na pływającym mierniku pulpitu (musi być włączone poniżej). Etykieta w zasobniku zawsze pokazuje wartości procentowe."

#. key: meter_opacity
msgid "Opacity:"
msgstr "Krycie:"

#. key: meter_width_px
msgid "Width (px):"
msgstr "Szerokość (px):"

#. key: meter_width_hint
msgid "(120–320)"
msgstr "(120–320)"

#. key: meter_lock
msgid "Lock position"
msgstr "Zablokuj położenie"

#. key: meter_unlock
msgid "Unlock"
msgstr "Odblokuj"

#. key: meter_hide
msgid "Hide meter"
msgstr "Ukryj miernik"

#. key: action_ok
msgid "OK"
msgstr "OK"

#. key: action_cancel
msgid "Cancel"
msgstr "Anuluj"

#. key: action_close
msgid "Close"
msgstr "Zamknij"

#. key: action_open
msgid "Open"
msgstr "Otwórz"

#. key: signin_dialog_body
msgid "Your browser should have opened to claude.ai. Complete sign-in there, then return here. This dialog will close automatically."
msgstr "Twoja przeglądarka powinna otworzyć stronę claude.ai. Dokończ tam logowanie i wróć tutaj. To okno dialogowe zostanie zamknięte automatycznie."

#. key: tooltip_lines
msgid "ClaudeBar\nSession: %d%%\nWeekly: %d%%"
msgstr "ClaudeBar\nSesja: %d%%\nTygodniowo: %d%%"

#. key: installer_welcome
msgid "Welcome to the ClaudeBar Setup"
msgstr "Witamy w instalatorze ClaudeBar"

#. key: installer_runtime_step
msgid ".NET 8 Desktop Runtime (x64)"
msgstr ".NET 8 Desktop Runtime (x64)"
