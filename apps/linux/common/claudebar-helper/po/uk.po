#. key: brand_name, window_preferences_title, tooltip_default, installer_app_step
#. DO NOT TRANSLATE. Keep as 'ClaudeBar' in every language.
msgid "ClaudeBar"
msgstr "ClaudeBar"

#. key: menu_refresh_now
msgid "Refresh now"
msgstr "Оновити зараз"

#. key: menu_open_usage_page
msgid "Open claude.ai/settings/usage"
msgstr "Відкрити claude.ai/settings/usage"

#. key: menu_settings
msgid "Settings…"
msgstr "Налаштування…"

#. key: menu_quit
msgid "Quit ClaudeBar"
msgstr "Вийти з ClaudeBar"

#. key: menu_refresh, prefs_refresh_section
msgid "Refresh"
msgstr "Оновити"

#. key: stat_session
msgid "Current session"
msgstr "Поточна сесія"

#. key: stat_session_dash
msgid "Current session: —"
msgstr "Поточна сесія: —"

#. key: stat_session_with_pct
msgid "Current session: %d%%"
msgstr "Поточна сесія: %d%%"

#. key: stat_weekly
msgid "Weekly (all models)"
msgstr "За тиждень (усі моделі)"

#. key: stat_weekly_dash
msgid "Weekly (all models): —"
msgstr "За тиждень (усі моделі): —"

#. key: stat_weekly_with_pct
msgid "Weekly (all models): %d%%"
msgstr "За тиждень (усі моделі): %d%%"

#. key: stat_resets
#. %s is a time-relative string like 'in 5 min'.
msgid "Resets %s"
msgstr "Скидання %s"

#. key: time_now
msgid "now"
msgstr "зараз"

#. key: time_dash
msgid "—"
msgstr "—"

#. key: time_in_minutes
msgid "in %d min"
msgstr "через %d хв"

#. key: time_in_hours
msgid "in %dh"
msgstr "через %d год"

#. key: time_in_hours_minutes
msgid "in %dh %dm"
msgstr "через %d год %d хв"

#. key: time_in_days
msgid "in %dd"
msgstr "через %d дн"

#. key: time_in_days_hours
msgid "in %dd %dh"
msgstr "через %d дн %d год"

#. key: status_offline
msgid "Offline — last value may be stale"
msgstr "Немає з'єднання — останнє значення може бути застарілим"

#. key: status_rate_limited
msgid "Rate limited by Claude API"
msgstr "Перевищено ліміт запитів Claude API"

#. key: status_unauthenticated
msgid "Not signed in — open Settings to add a token"
msgstr "Не виконано вхід — відкрийте Налаштування, щоб додати токен"

#. key: auth_sign_in, signin_dialog_heading
msgid "Sign in with Claude"
msgstr "Увійти через Claude"

#. key: auth_sign_out
msgid "Sign out"
msgstr "Вийти"

#. key: auth_signed_in_token
#. %s is the last 6 chars of the access token.
msgid "Signed in (token ends '…%s')"
msgstr "Виконано вхід (токен закінчується на «…%s»)"

#. key: auth_not_signed_in
msgid "Not signed in"
msgstr "Не виконано вхід"

#. key: auth_checking
msgid "Checking…"
msgstr "Перевірка…"

#. key: auth_waiting_browser
msgid "Waiting for browser sign-in…"
msgstr "Очікування входу в браузері…"

#. key: auth_keyring_error
msgid "Keyring error — see logs"
msgstr "Помилка сховища ключів — див. журнали"

#. key: auth_sign_in_failed
msgid "Sign-in failed"
msgstr "Не вдалося увійти"

#. key: auth_could_not_start
msgid "Could not start sign-in"
msgstr "Не вдалося розпочати вхід"

#. key: auth_copy_link
#. Short button label — used both in prefs dialogs and as a system-notification action where supported.
msgid "Copy link"
msgstr "Копіювати посилання"

#. key: auth_link_copied_notify
#. Notification body shown after a menu/popup Sign-in click. Body of an OS desktop notification (libnotify on Linux). Title is the brand name.
msgid "Sign-in link copied to clipboard"
msgstr "Посилання для входу скопійовано в буфер обміну"

#. key: prefs_account
msgid "Account"
msgstr "Обліковий запис"

#. key: prefs_display
msgid "Display"
msgstr "Відображення"

#. key: prefs_advanced
msgid "Advanced"
msgstr "Додатково"

#. key: prefs_general
msgid "General"
msgstr "Загальні"

#. key: prefs_authentication
msgid "Authentication"
msgstr "Автентифікація"

#. key: prefs_status
msgid "Status"
msgstr "Стан"

#. key: prefs_top_bar
msgid "Top bar"
msgstr "Верхня панель"

#. key: prefs_tray_icon
msgid "Tray icon"
msgstr "Піктограма в треї"

#. key: prefs_color_thresholds
msgid "Color thresholds"
msgstr "Кольорові пороги"

#. key: prefs_labels
msgid "Labels:"
msgstr "Підписи:"

#. key: prefs_account_subtitle
msgid "Sign in with your Claude account to fetch Max plan usage. Tokens are stored in GNOME Keyring via libsecret."
msgstr "Увійдіть зі своїм обліковим записом Claude, щоб отримати дані про використання тарифу Max. Токени зберігаються в GNOME Keyring через libsecret."

#. key: prefs_show_percentages
msgid "Show numeric percentages next to bars"
msgstr "Показувати числові відсотки поруч зі смугами"

#. key: prefs_show_percentages_subtitle
msgid "Small session and weekly percentages, stacked beside the bars."
msgstr "Невеликі відсотки сесії та тижня, розташовані поруч зі смугами."

#. key: prefs_show_percentages_beside
msgid "Show numeric percentages beside the bars"
msgstr "Показувати числові відсотки поруч зі смугами"

#. key: prefs_color_thresholds_desc
msgid "When bars switch from green to orange to red."
msgstr "Коли смуги змінюють колір із зеленого на помаранчевий, а потім на червоний."

#. key: prefs_orange_at
msgid "Orange at"
msgstr "Помаранчевий при"

#. key: prefs_red_at
msgid "Red at"
msgstr "Червоний при"

#. key: prefs_orange_at_pct
msgid "Orange at (%)"
msgstr "Помаранчевий при (%)"

#. key: prefs_red_at_pct
msgid "Red at (%)"
msgstr "Червоний при (%)"

#. key: prefs_orange_at_short
msgid "Orange at (%):"
msgstr "Помаранчевий при (%):"

#. key: prefs_red_at_short
msgid "Red at (%):"
msgstr "Червоний при (%):"

#. key: prefs_poll_interval_seconds
msgid "Poll interval (seconds)"
msgstr "Інтервал опитування (секунди)"

#. key: prefs_poll_interval_short
msgid "Poll interval (s):"
msgstr "Інтервал опитування (с):"

#. key: prefs_helper_path
msgid "Helper binary:"
msgstr "Допоміжний бінарний файл:"

#. key: meter_section
msgid "Floating desktop meter"
msgstr "Плаваючий індикатор на робочому столі"

#. key: meter_enable
msgid "Show always-on-top meter on the desktop"
msgstr "Показувати індикатор поверх усіх вікон на робочому столі"

#. key: meter_desc
msgid "Small transparent widget rendering full-size bars. Draggable into any corner; right-click to lock or hide."
msgstr "Невеликий прозорий віджет із повнорозмірними смугами. Перетягується в будь-який кут; клацніть правою кнопкою, щоб закріпити або приховати."

#. key: meter_show_percentages
msgid "Show numeric percentages on the floating meter"
msgstr "Показувати числові відсотки на плаваючому індикаторі"

#. key: meter_show_percentages_subtitle
msgid "Adds session and weekly percentages next to the bars on the floating desktop meter (must be enabled below). The tray tooltip always shows percentages."
msgstr "Додає відсотки сесії та тижня поруч зі смугами на плаваючому індикаторі робочого стола (має бути ввімкнено нижче). Підказка в треї завжди показує відсотки."

#. key: meter_opacity
msgid "Opacity:"
msgstr "Непрозорість:"

#. key: meter_width_px
msgid "Width (px):"
msgstr "Ширина (пікс.):"

#. key: meter_width_hint
msgid "(120–320)"
msgstr "(120–320)"

#. key: meter_lock
msgid "Lock position"
msgstr "Зафіксувати положення"

#. key: meter_unlock
msgid "Unlock"
msgstr "Розблокувати"

#. key: meter_hide
msgid "Hide meter"
msgstr "Сховати індикатор"

#. key: action_ok
msgid "OK"
msgstr "ОК"

#. key: action_cancel
msgid "Cancel"
msgstr "Скасувати"

#. key: action_close
msgid "Close"
msgstr "Закрити"

#. key: action_open
msgid "Open"
msgstr "Відкрити"

#. key: signin_dialog_body
msgid "Your browser should have opened to claude.ai. Complete sign-in there, then return here. This dialog will close automatically."
msgstr "Ваш браузер мав відкрити claude.ai. Завершіть вхід там і поверніться сюди. Це діалогове вікно закриється автоматично."

#. key: tooltip_lines
msgid "ClaudeBar\nSession: %d%%\nWeekly: %d%%"
msgstr "ClaudeBar\nСесія: %d%%\nЗа тиждень: %d%%"

#. key: installer_welcome
msgid "Welcome to the ClaudeBar Setup"
msgstr "Ласкаво просимо до встановлення ClaudeBar"

#. key: installer_runtime_step
msgid ".NET 8 Desktop Runtime (x64)"
msgstr ".NET 8 Desktop Runtime (x64)"
