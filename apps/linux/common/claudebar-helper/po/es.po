#. key: brand_name, window_preferences_title, tooltip_default, installer_app_step
#. DO NOT TRANSLATE. Keep as 'ClaudeBar' in every language.
msgid "ClaudeBar"
msgstr "ClaudeBar"

#. key: menu_refresh_now
msgid "Refresh now"
msgstr "Actualizar ahora"

#. key: menu_open_usage_page
msgid "Open claude.ai/settings/usage"
msgstr "Abrir claude.ai/settings/usage"

#. key: menu_settings
msgid "Settings…"
msgstr "Ajustes…"

#. key: menu_quit
msgid "Quit ClaudeBar"
msgstr "Salir de ClaudeBar"

#. key: menu_refresh, prefs_refresh_section
msgid "Refresh"
msgstr "Actualizar"

#. key: stat_session
msgid "Current session"
msgstr "Sesión actual"

#. key: stat_session_dash
msgid "Current session: —"
msgstr "Sesión actual: —"

#. key: stat_session_with_pct
msgid "Current session: %d%%"
msgstr "Sesión actual: %d%%"

#. key: stat_weekly
msgid "Weekly (all models)"
msgstr "Semanal (todos los modelos)"

#. key: stat_weekly_dash
msgid "Weekly (all models): —"
msgstr "Semanal (todos los modelos): —"

#. key: stat_weekly_with_pct
msgid "Weekly (all models): %d%%"
msgstr "Semanal (todos los modelos): %d%%"

#. key: stat_resets
#. %s is a time-relative string like 'in 5 min'.
msgid "Resets %s"
msgstr "Se reinicia %s"

#. key: time_now
msgid "now"
msgstr "ahora"

#. key: time_dash
msgid "—"
msgstr "—"

#. key: time_in_minutes
msgid "in %d min"
msgstr "en %d min"

#. key: time_in_hours
msgid "in %dh"
msgstr "en %d h"

#. key: time_in_hours_minutes
msgid "in %dh %dm"
msgstr "en %d h %d min"

#. key: time_in_days
msgid "in %dd"
msgstr "en %d d"

#. key: time_in_days_hours
msgid "in %dd %dh"
msgstr "en %d d %d h"

#. key: status_offline
msgid "Offline — last value may be stale"
msgstr "Sin conexión — el último valor puede estar desactualizado"

#. key: status_rate_limited
msgid "Rate limited by Claude API"
msgstr "Límite de tasa de Claude API alcanzado"

#. key: status_unauthenticated
msgid "Not signed in — open Settings to add a token"
msgstr "No has iniciado sesión — abre Ajustes para añadir un token"

#. key: auth_sign_in, signin_dialog_heading
msgid "Sign in with Claude"
msgstr "Iniciar sesión con Claude"

#. key: auth_sign_out
msgid "Sign out"
msgstr "Cerrar sesión"

#. key: auth_signed_in_token
#. %s is the last 6 chars of the access token.
msgid "Signed in (token ends '…%s')"
msgstr "Sesión iniciada (el token termina en «…%s»)"

#. key: auth_not_signed_in
msgid "Not signed in"
msgstr "Sesión no iniciada"

#. key: auth_checking
msgid "Checking…"
msgstr "Comprobando…"

#. key: auth_waiting_browser
msgid "Waiting for browser sign-in…"
msgstr "Esperando el inicio de sesión en el navegador…"

#. key: auth_keyring_error
msgid "Keyring error — see logs"
msgstr "Error del llavero — consulta los registros"

#. key: auth_sign_in_failed
msgid "Sign-in failed"
msgstr "Error al iniciar sesión"

#. key: auth_could_not_start
msgid "Could not start sign-in"
msgstr "No se pudo iniciar la sesión"

#. key: auth_copy_link
#. Short button label — used both in prefs dialogs and as a system-notification action where supported.
msgid "Copy link"
msgstr "Copiar enlace"

#. key: auth_link_copied_notify
#. Notification body shown after a menu/popup Sign-in click. Body of an OS desktop notification (libnotify on Linux). Title is the brand name.
msgid "Sign-in link copied to clipboard"
msgstr "Enlace de inicio de sesión copiado al portapapeles"

#. key: prefs_account
msgid "Account"
msgstr "Cuenta"

#. key: prefs_display
msgid "Display"
msgstr "Pantalla"

#. key: prefs_advanced
msgid "Advanced"
msgstr "Avanzado"

#. key: prefs_general
msgid "General"
msgstr "General"

#. key: prefs_authentication
msgid "Authentication"
msgstr "Autenticación"

#. key: prefs_status
msgid "Status"
msgstr "Estado"

#. key: prefs_top_bar
msgid "Top bar"
msgstr "Barra superior"

#. key: prefs_tray_icon
msgid "Tray icon"
msgstr "Icono de la bandeja"

#. key: prefs_color_thresholds
msgid "Color thresholds"
msgstr "Umbrales de color"

#. key: prefs_labels
msgid "Labels:"
msgstr "Etiquetas:"

#. key: prefs_account_subtitle
msgid "Sign in with your Claude account to fetch Max plan usage. Tokens are stored in GNOME Keyring via libsecret."
msgstr "Inicie sesión con su cuenta de Claude para obtener el uso del plan Max. Los tokens se almacenan en GNOME Keyring mediante libsecret."

#. key: prefs_show_percentages
msgid "Show numeric percentages next to bars"
msgstr "Mostrar porcentajes numéricos junto a las barras"

#. key: prefs_show_percentages_subtitle
msgid "Small session and weekly percentages, stacked beside the bars."
msgstr "Pequeños porcentajes de sesión y semanales, apilados junto a las barras."

#. key: prefs_show_percentages_beside
msgid "Show numeric percentages beside the bars"
msgstr "Mostrar porcentajes numéricos junto a las barras"

#. key: prefs_color_thresholds_desc
msgid "When bars switch from green to orange to red."
msgstr "Cuándo las barras pasan de verde a naranja y luego a rojo."

#. key: prefs_orange_at
msgid "Orange at"
msgstr "Naranja en"

#. key: prefs_red_at
msgid "Red at"
msgstr "Rojo en"

#. key: prefs_orange_at_pct
msgid "Orange at (%)"
msgstr "Naranja en (%)"

#. key: prefs_red_at_pct
msgid "Red at (%)"
msgstr "Rojo en (%)"

#. key: prefs_orange_at_short
msgid "Orange at (%):"
msgstr "Naranja en (%):"

#. key: prefs_red_at_short
msgid "Red at (%):"
msgstr "Rojo en (%):"

#. key: prefs_poll_interval_seconds
msgid "Poll interval (seconds)"
msgstr "Intervalo de sondeo (segundos)"

#. key: prefs_poll_interval_short
msgid "Poll interval (s):"
msgstr "Intervalo de sondeo (s):"

#. key: prefs_helper_path
msgid "Helper binary:"
msgstr "Binario auxiliar:"

#. key: meter_section
msgid "Floating desktop meter"
msgstr "Medidor flotante de escritorio"

#. key: meter_enable
msgid "Show always-on-top meter on the desktop"
msgstr "Mostrar un medidor siempre visible en el escritorio"

#. key: meter_desc
msgid "Small transparent widget rendering full-size bars. Draggable into any corner; right-click to lock or hide."
msgstr "Pequeño widget transparente que muestra barras a tamaño completo. Se puede arrastrar a cualquier esquina; haga clic con el botón derecho para bloquearlo u ocultarlo."

#. key: meter_show_percentages
msgid "Show numeric percentages on the floating meter"
msgstr "Mostrar porcentajes numéricos en el medidor flotante"

#. key: meter_show_percentages_subtitle
msgid "Adds session and weekly percentages next to the bars on the floating desktop meter (must be enabled below). The tray tooltip always shows percentages."
msgstr "Añade los porcentajes de sesión y semanales junto a las barras del medidor flotante de escritorio (debe estar habilitado más abajo). La información sobre herramientas de la bandeja siempre muestra porcentajes."

#. key: meter_opacity
msgid "Opacity:"
msgstr "Opacidad:"

#. key: meter_width_px
msgid "Width (px):"
msgstr "Anchura (px):"

#. key: meter_width_hint
msgid "(120–320)"
msgstr "(120–320)"

#. key: meter_lock
msgid "Lock position"
msgstr "Bloquear posición"

#. key: meter_unlock
msgid "Unlock"
msgstr "Desbloquear"

#. key: meter_hide
msgid "Hide meter"
msgstr "Ocultar medidor"

#. key: action_ok
msgid "OK"
msgstr "Aceptar"

#. key: action_cancel
msgid "Cancel"
msgstr "Cancelar"

#. key: action_close
msgid "Close"
msgstr "Cerrar"

#. key: action_open
msgid "Open"
msgstr "Abrir"

#. key: signin_dialog_body
msgid "Your browser should have opened to claude.ai. Complete sign-in there, then return here. This dialog will close automatically."
msgstr "Su navegador debería haberse abierto en claude.ai. Complete el inicio de sesión allí y luego vuelva aquí. Este cuadro de diálogo se cerrará automáticamente."

#. key: tooltip_lines
msgid "ClaudeBar\nSession: %d%%\nWeekly: %d%%"
msgstr "ClaudeBar\nSesión: %d%%\nSemanal: %d%%"

#. key: installer_welcome
msgid "Welcome to the ClaudeBar Setup"
msgstr "Bienvenido a la instalación de ClaudeBar"

#. key: installer_runtime_step
msgid ".NET 8 Desktop Runtime (x64)"
msgstr ".NET 8 Desktop Runtime (x64)"
