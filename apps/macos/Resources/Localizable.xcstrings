    "Your browser should have opened to claude.ai. Complete sign-in there, then return here. This dialog will close automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من المفترض أن يكون متصفحك قد فتح claude.ai. أكمل تسجيل الدخول هناك ثم عُد إلى هنا. سيُغلق مربع الحوار هذا تلقائيًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš prohlížeč by se měl otevřít na claude.ai. Dokončete tam přihlášení a poté se vraťte sem. Toto dialogové okno se automaticky zavře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Browser sollte sich auf claude.ai geöffnet haben. Schließen Sie die Anmeldung dort ab und kehren Sie dann hierher zurück. Dieses Dialogfeld wird automatisch geschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your browser should have opened to claude.ai. Complete sign-in there, then return here. This dialog will close automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su navegador debería haberse abierto en claude.ai. Complete el inicio de sesión allí y luego vuelva aquí. Este cuadro de diálogo se cerrará automáticamente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مرورگر شما باید claude.ai را باز کرده باشد. ورود را در آنجا تکمیل کنید و سپس به اینجا بازگردید. این پنجره به‌طور خودکار بسته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre navigateur devrait s'être ouvert sur claude.ai. Terminez la connexion là-bas, puis revenez ici. Cette boîte de dialogue se fermera automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका ब्राउज़र claude.ai पर खुल गया होगा। वहाँ साइन-इन पूरा करें, फिर यहाँ लौटें। यह संवाद स्वतः बंद हो जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo browser dovrebbe aver aperto claude.ai. Completa l'accesso lì, quindi torna qui. Questa finestra di dialogo si chiuderà automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで claude.ai が開いているはずです。そちらでサインインを完了し、こちらに戻ってください。このダイアログは自動的に閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저가 claude.ai로 열렸을 것입니다. 그곳에서 로그인을 완료한 후 이 화면으로 돌아오십시오. 이 대화 상자는 자동으로 닫힙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw browser zou claude.ai geopend moeten hebben. Voltooi daar de aanmelding en kom dan hier terug. Dit dialoogvenster wordt automatisch gesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja przeglądarka powinna otworzyć stronę claude.ai. Dokończ tam logowanie i wróć tutaj. To okno dialogowe zostanie zamknięte automatycznie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu navegador deverá ter aberto em claude.ai. Conclua o início de sessão aí e regresse a esta janela. Esta caixa de diálogo será fechada automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш браузер должен был открыть claude.ai. Завершите вход там и вернитесь сюда. Это диалоговое окно закроется автоматически."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din webbläsare bör ha öppnats på claude.ai. Slutför inloggningen där och återvänd sedan hit. Den här dialogrutan stängs automatiskt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcınız claude.ai adresini açmış olmalı. Oturum açmayı orada tamamlayın ve buraya geri dönün. Bu iletişim kutusu otomatik olarak kapanacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш браузер мав відкрити claude.ai. Завершіть вхід там і поверніться сюди. Це діалогове вікно закриється автоматично."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "您的浏览器应已打开 claude.ai。请在那里完成登录,然后返回此处。此对话框将自动关闭。"
          }
        }
      }
