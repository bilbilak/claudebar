    "When bars switch from green to orange to red.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى تتغير الأشرطة من الأخضر إلى البرتقالي ثم إلى الأحمر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdy pruhy přejdou ze zelené přes oranžovou až na červenou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann die Balken von Grün auf Orange und dann auf Rot wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When bars switch from green to orange to red."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo las barras pasan de verde a naranja y luego a rojo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمانی که رنگ نوارها از سبز به نارنجی و سپس قرمز تغییر می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand les barres passent du vert à l'orange puis au rouge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब बार हरे से नारंगी और फिर लाल हो जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando le barre passano dal verde all'arancione e poi al rosso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーが緑からオレンジ、そして赤に切り替わるタイミング。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막대 색상이 녹색에서 주황색, 빨간색으로 바뀌는 시점입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer balken van groen naar oranje en vervolgens naar rood overgaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy paski zmieniają kolor z zielonego na pomarańczowy, a następnie czerwony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando as barras passam de verde para laranja e depois para vermelho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда полосы меняют цвет с зелёного на оранжевый, затем на красный."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När staplarna växlar från grönt till orange till rött."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çubukların yeşilden turuncuya ve kırmızıya geçtiği eşikler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли смуги змінюють колір із зеленого на помаранчевий, а потім на червоний."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "条形从绿色变为橙色再变为红色的时机。"
          }
        }
      }
    },
