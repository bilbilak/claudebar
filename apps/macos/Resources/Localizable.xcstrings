        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Sitzungs- und Wochenprozentwerte, neben den Balken übereinander angeordnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small session and weekly percentages, stacked beside the bars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeños porcentajes de sesión y semanales, apilados junto a las barras."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درصدهای کوچک نشست و هفتگی، در کنار نوارها روی هم چیده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petits pourcentages de session et hebdomadaires, empilés à côté des barres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बार के बगल में लंबवत रूप से छोटे सत्र और साप्ताहिक प्रतिशत।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piccole percentuali di sessione e settimanali, impilate accanto alle barre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションと週間の小さなパーセンテージをバーの横に縦に並べて表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막대 옆에 작은 세션 및 주간 백분율이 세로로 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine sessie- en weekpercentages, gestapeld naast de balken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niewielkie wartości procentowe sesji i tygodnia, ułożone obok pasków."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequenas percentagens da sessão e semanais, empilhadas ao lado das barras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Небольшие проценты сессии и недели, расположенные рядом с полосами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Små procentvärden för session och vecka, staplade bredvid staplarna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çubukların yanında üst üste dizilmiş küçük oturum ve haftalık yüzdeler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невеликі відсотки сесії та тижня, розташовані поруч зі смугами."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在条形旁堆叠显示小号的会话和每周百分比。"
          }
        }
      }
    },
    "Small transparent widget rendering full-size bars. Draggable into any corner; right-click to lock or hide.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أداة شفافة صغيرة تعرض أشرطة بحجم كامل. يمكن سحبها إلى أي ركن؛ انقر بزر الفأرة الأيمن للتثبيت أو الإخفاء."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Malý průhledný widget zobrazující pruhy v plné velikosti. Lze jej přetáhnout do libovolného rohu; kliknutím pravým tlačítkem jej uzamknete nebo skryjete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleines transparentes Widget mit Balken in voller Größe. In jede Ecke ziehbar; mit Rechtsklick fixieren oder ausblenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small transparent widget rendering full-size bars. Draggable into any corner; right-click to lock or hide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeño widget transparente que muestra barras a tamaño completo. Se puede arrastrar a cualquier esquina; haga clic con el botón derecho para bloquearlo u ocultarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابزارک کوچک و شفافی که نوارها را در اندازهٔ کامل نمایش می‌دهد. می‌توان آن را به هر گوشه‌ای کشید؛ برای قفل یا پنهان‌سازی، راست‌کلیک کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit widget transparent affichant des barres en taille réelle. Déplaçable dans n'importe quel coin ; clic droit pour le verrouiller ou le masquer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण आकार के बार दिखाने वाला छोटा पारदर्शी विजेट। किसी भी कोने में खींचा जा सकता है; लॉक करने या छिपाने के लिए दायाँ-क्लिक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piccolo widget trasparente che mostra barre a grandezza naturale. Può essere trascinato in qualsiasi angolo; fai clic con il pulsante destro per bloccarlo o nasconderlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルサイズのバーを表示する小さな透明ウィジェット。任意の隅にドラッグでき、右クリックで固定または非表示にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 크기의 막대를 표시하는 작은 투명 위젯입니다. 원하는 모서리로 끌어다 놓을 수 있으며, 마우스 오른쪽 버튼을 클릭하여 잠그거나 숨길 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein transparant widget dat balken op volledige grootte weergeeft. Versleepbaar naar elke hoek; klik met de rechtermuisknop om te vergrendelen of te verbergen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mały przezroczysty widżet wyświetlający paski w pełnym rozmiarze. Można go przeciągnąć w dowolny róg; kliknij prawym przyciskiem myszy, aby zablokować lub ukryć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeno widget transparente que apresenta barras em tamanho real. Pode ser arrastado para qualquer canto; clique com o botão direito para bloquear ou ocultar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Небольшой прозрачный виджет с полноразмерными полосами. Можно перетащить в любой угол; правый клик — закрепить или скрыть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liten genomskinlig widget som visar staplar i full storlek. Kan dras till valfritt hörn; högerklicka för att låsa eller dölja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam boyutlu çubuklar gösteren küçük şeffaf bir araç. İstediğiniz köşeye sürüklenebilir; kilitlemek veya gizlemek için sağ tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невеликий прозорий віджет із повнорозмірними смугами. Перетягується в будь-який кут; клацніть правою кнопкою, щоб закріпити або приховати."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "小型透明小部件,显示完整尺寸的条形。可拖动到任意角落;右键单击可锁定或隐藏。"
          }
        }
      }
    },
